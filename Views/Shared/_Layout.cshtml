<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My ASP.NET Application</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("AdoptPets", "Index", "Home", null, new { @class = "navbar-brand" })

            <ul class="nav navbar-nav">
                <li>@Html.ActionLink("Životinje", "Index", "announcements")</li>

                @if (Session["UserId"] != null)
                {
                    <li>@Html.ActionLink("Dodaj oglas", "Create", "announcements")</li>
                    <li>@Html.ActionLink("Usvojene životinje", "MyAdoptions", "updates")</li>
                    <li>@Html.ActionLink("Moje životinje", "Mine", "announcements")</li>
                    <li>@Html.ActionLink("Moji zahtjevi", "Mine", "requests")</li>
                }
            </ul>

            <ul class="nav navbar-nav navbar-right">
                @if (Session["UserId"] == null)
                {
                    <li>@Html.ActionLink("Registracija", "Register", "Auth")</li>
                    <li>@Html.ActionLink("Prijava", "Login", "Auth")</li>
                }
                else
                {
                    <li><a>Zdravo, @Session["Username"]</a></li>
                    <li>@Html.ActionLink("Odjava", "Logout", "Auth")</li>
                }
            </ul>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
